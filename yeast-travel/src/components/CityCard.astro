---
import type { City } from "../data/types";
interface Props { city: City; }
const { city } = Astro.props;
---
<article class:list={["city-card", "card", city.accent]}>
  <div class="city-number" aria-hidden="true">{city.nameZh.slice(0, 1)}</div>
  <span class="tag">{city.region}</span>
  <h3>{city.name}</h3>
  <p class="zh">{city.nameZh}</p>
  <p>{city.character}</p>
  <div class="meta"><span>Best for {city.idealDays}</span><span>3 day modules</span></div>
  <a class="button" href={`/cities/${city.slug}`}>Meet {city.name} <span aria-hidden="true">↗</span></a>
</article>

<style>
  .city-card { position: relative; min-height: 390px; padding: 24px; overflow: hidden; }
  .city-card::after { content: ""; position: absolute; right: -50px; bottom: -70px; width: 180px; height: 180px; border-radius: 50%; opacity: .4; background: var(--lilac); }
  .city-card.coral::after { background: #ffc2b7; } .city-card.lime::after { background: var(--lime); }
  .city-card.sky::after { background: var(--sky); } .city-card.violet::after { background: var(--lilac); }
  .city-number { position: absolute; right: 12px; top: -25px; font-family: var(--display); font-size: 140px; line-height: 1; opacity: .08; }
  h3 { margin: 72px 0 0; font-family: var(--display); font-size: 46px; font-weight: 400; line-height: 1; }
  .zh { margin: 5px 0 18px; color: var(--coral-dark); font-size: 12px; font-weight: 900; letter-spacing: .12em; }
  p:not(.zh) { max-width: 28ch; color: var(--muted); font-size: 14px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 28px 0 18px; color: var(--muted); font-size: 11px; font-weight: 750; }
  .button { position: relative; z-index: 1; }
</style>
