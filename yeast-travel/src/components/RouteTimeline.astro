---
import type { RouteModule } from "../data/types";
interface Props { route: RouteModule; compact?: boolean; }
const { route, compact = false } = Astro.props;
---
<ol class:list={["timeline", { compact }]}>
  {route.stops.map((stop, index) => (
    <li>
      <div class="marker"><span>{String(index + 1).padStart(2,"0")}</span></div>
      <div class="stop-card">
        <div class="stop-head">
          <div><p class="eyebrow">{stop.arrival} · {stop.duration}</p><h3>{stop.name}</h3><p class="zh">{stop.nameZh}</p></div>
          <span class="cost">{stop.cost}</span>
        </div>
        <p>{stop.note}</p>
        {!compact && <>
          <dl><div><dt>Chinese address</dt><dd>{stop.addressZh}</dd></div><div><dt>Before you go</dt><dd>{stop.opening} {stop.booking}</dd></div><div><dt>If plans change</dt><dd>{stop.fallback}</dd></div></dl>
          <div class="actions">
            <button class="button button-soft copy-address" type="button" data-address={stop.addressZh} data-route={route.slug}>Copy Chinese address</button>
            <a class="button" href={stop.amapUrl} target="_blank" rel="noreferrer" data-map-link data-route={route.slug}>Open in Amap ↗</a>
            <a class="source" href={stop.sourceUrl} target="_blank" rel="noreferrer">Source: {stop.sourceLabel}</a>
          </div>
        </>}
      </div>
    </li>
  ))}
</ol>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-address").forEach((button) => button.addEventListener("click", async () => {
    const address = button.dataset.address || "";
    try { await navigator.clipboard.writeText(address); button.textContent = "Copied ✓"; }
    catch { window.prompt("Copy this Chinese address", address); }
    window.yeastTrack?.("address_copied", { route: button.dataset.route || "" });
  }));
  document.querySelectorAll<HTMLAnchorElement>("[data-map-link]").forEach((link) => link.addEventListener("click", () => {
    window.yeastTrack?.("map_opened", { route: link.dataset.route || "" });
  }));
</script>

<style>
  .timeline { margin: 0; padding: 0; list-style: none; }
  li { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 18px; padding-bottom: 24px; }
  li:not(:last-child)::before { content: ""; position: absolute; left: 27px; top: 49px; bottom: -5px; width: 2px; background: linear-gradient(var(--coral), var(--violet)); opacity: .35; }
  .marker { position: relative; z-index: 1; width: 56px; height: 56px; display: grid; place-items: center; border-radius: 50% 44% 52% 42%; color: white; background: var(--gradient); transform: rotate(-4deg); }
  .marker span { font-size: 11px; font-weight: 900; transform: rotate(4deg); }
  .stop-card { padding: 24px; border: 1px solid var(--line); border-radius: 22px; background: rgba(255,255,255,.68); }
  .stop-head { display: flex; justify-content: space-between; gap: 20px; }
  .eyebrow { margin-bottom: 6px; color: var(--muted); }
  h3 { margin-bottom: 0; font-family: var(--display); font-size: 34px; font-weight: 400; letter-spacing: -.035em; }
  .zh { margin: 5px 0 14px; color: var(--coral-dark); font-size: 12px; font-weight: 850; }
  .cost { height: max-content; padding: 6px 10px; border-radius: 999px; background: var(--lime); font-size: 10px; font-weight: 850; white-space: nowrap; }
  .stop-card > p { color: var(--muted); }
  dl { display: grid; gap: 10px; margin: 22px 0; }
  dl div { padding-top: 10px; border-top: 1px dashed var(--line); }
  dt { color: var(--muted); font-size: 9px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  dd { margin: 4px 0 0; font-size: 13px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; }
  .actions .button { min-height: 40px; padding: 8px 12px; font-size: 11px; }
  .source { margin-left: auto; color: var(--muted); font-size: 10px; }
  .compact .stop-card { padding: 18px; } .compact dl, .compact .actions { display: none; }
  @media (max-width: 540px) { li { grid-template-columns: 40px 1fr; gap: 10px; } .marker { width: 40px; height: 40px; } li:not(:last-child)::before { left: 19px; top: 40px; } .stop-card { padding: 18px; } .stop-head { display: block; } .cost { display: inline-block; margin-bottom: 12px; } .source { width: 100%; margin: 6px 0 0; } }
</style>
