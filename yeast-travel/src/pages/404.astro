---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Route not found — Yeast Travel" description="This Yeast Travel route does not exist." noindex={true}><section class="missing shell"><span>404</span><h1>This route<br/>didn’t rise.</h1><p>Try one of the four city plans instead.</p><a class="button button-primary" href="/#cities">Choose a city</a></section></BaseLayout>
<style>.missing{min-height:650px;padding-block:100px;text-align:center}.missing>span{color:var(--coral);font-family:var(--display);font-size:34px}.missing h1{margin:20px 0;font-family:var(--display);font-size:clamp(70px,12vw,150px);font-weight:400;line-height:.78;letter-spacing:-.07em}.missing p{color:var(--muted)}</style>
