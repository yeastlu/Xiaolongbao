---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cities } from "../data/content";
---
<BaseLayout title="Request a private route — Yeast Travel" description="Tell Yeast what kind of licensed local experience you are looking for. No booking or payment is taken here." noindex={true}>
  <section class="request shell"><div><span class="eyebrow">Interest request · Not a booking</span><h1>Need a human-led route?</h1><p class="lede">Tell Yeast the basics. We will first review the request internally. Your contact is not sent to an operator until that operator is named and you separately agree.</p></div><form name="route-interest" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you"><input type="hidden" name="form-name" value="route-interest" /><p class="hidden"><label>Do not fill <input name="bot-field" /></label></p><label>City<select name="city" required>{cities.map((city) => <option value={city.slug}>{city.name} · {city.nameZh}</option>)}</select></label><div class="row"><label>Date<input type="date" name="date" required /></label><label>People<input type="number" name="people" min="1" max="30" value="2" required /></label></div><label>Preferred language<input type="text" name="language" value="English" required /></label><label>Email or WhatsApp<input type="text" name="contact" autocomplete="email" required /></label><label class="consent"><input type="checkbox" name="yeast-consent" required /> Yeast may use these details to respond to this request. No supplier transfer is authorised by this form.</label><button class="button button-primary" type="submit">Send interest request</button><p class="fine">Do not include passport, payment, health or live-location information.</p></form></section>
</BaseLayout>
<style>.request{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start;padding-block:80px}.request h1{margin:25px 0;font-family:var(--display);font-size:clamp(60px,8vw,100px);font-weight:400;line-height:.86;letter-spacing:-.06em}form{display:grid;gap:16px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow)}label:not(.consent){display:grid;gap:7px;font-size:11px;font-weight:800}input,select{width:100%;min-height:48px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--paper)}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.consent,.fine{color:var(--muted);font-size:10px}.fine{margin:0;text-align:center}.hidden{display:none}@media(max-width:760px){.request{grid-template-columns:1fr}}</style>
