---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Thank you — Yeast Travel" description="Yeast Travel has received your form." noindex={true}><section class="thanks shell"><span class="eyebrow">Received</span><h1>Your message is<br/><span>fermenting.</span></h1><p class="lede">We have received the form. This is not a booking confirmation and no payment has been taken.</p><a class="button button-primary" href="/">Back to the plans</a></section></BaseLayout>
<style>.thanks{min-height:650px;padding-block:110px;text-align:center}.thanks h1{margin:25px auto;font-family:var(--display);font-size:clamp(65px,10vw,125px);font-weight:400;line-height:.84;letter-spacing:-.06em}.thanks h1 span{color:transparent;background:var(--gradient);background-clip:text}.thanks .lede{margin:0 auto 30px}</style>
