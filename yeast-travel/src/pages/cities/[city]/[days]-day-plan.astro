---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { cities, getCityRoutes } from "../../../data/content";
import { interestLabels } from "../../../data/site";
export function getStaticPaths() { return cities.flatMap((city) => ([1,2,3] as const).map((days) => ({ params: { city: city.slug, days: String(days) }, props: { city, days } }))); }
const { city, days } = Astro.props;
const selectedRoutes = getCityRoutes(city.slug).slice(0, days);
const chosen = (Astro.url.searchParams.get("interests") || "").split(",").filter((item) => item in interestLabels).slice(0,2);
---
<BaseLayout title={`${days} days in ${city.name} — Yeast Travel`} description={`A realistic ${days}-day ${city.name} itinerary with bilingual addresses, time budgets, Amap links and backup plans.`} noindex={true}>
  <section class="plan-head shell">
    <nav class="crumbs"><a href="/">Home</a><span>→</span><a href={`/cities/${city.slug}`}>{city.name}</a><span>→</span><span>{days}-day plan</span></nav>
    <span class="eyebrow">Your fixed-route plan · Research preview</span>
    <h1><span>{days}</span> {days === 1 ? "day" : "days"} in {city.name}</h1>
    <p class="lede">A practical sequence built from researched day modules. It does not invent new places from your prompt.</p>
    {chosen.length > 0 && <div class="chosen">Saved interests: {chosen.map((item) => interestLabels[item as keyof typeof interestLabels]).join(" + ")} · route remains fixed in preview</div>}
    <div class="plan-actions"><a class="button button-primary" href="#days">Start with Day 1</a><button class="button button-soft" id="save-plan" type="button">Save in this browser</button></div>
  </section>
  <section class="shell overview" id="days">
    {selectedRoutes.map((route) => <article class="day-block">
      <div class="day-side"><span>Day {route.day}</span><h2>{route.name}</h2><p>{route.duration} · {route.pace} pace</p><a class="text-link" href={`/routes/${route.slug}`}>Full route details →</a></div>
      <div class="stop-list">{route.stops.map((stop, i) => <div><span>{String(i+1).padStart(2,"0")}</span><p><strong>{stop.name}</strong><small>{stop.nameZh} · {stop.duration}</small></p><button type="button" data-address={stop.addressZh}>Copy address</button></div>)}</div>
      <div class="backup"><strong>Plan B</strong><p>{route.rainyDay}</p></div>
    </article>)}
  </section>
  <section class="shell beta"><strong>This is not field-verified yet.</strong><p>All stops use official-source desk research checked 19 July 2026. Before you travel, check current opening and booking rules. Yeast will remove this notice only after route walks and map testing.</p></section>
  <script is:inline define:vars={{ citySlug: city.slug, planDays: days, selectedInterests: chosen }}>
    document.querySelectorAll('[data-address]').forEach((button) => button.addEventListener('click', async () => {
      const value = button.dataset.address || '';
      try { await navigator.clipboard.writeText(value); button.textContent = 'Copied ✓'; } catch { window.prompt('Copy this Chinese address', value); }
      window.yeastTrack?.('address_copied', { city: citySlug });
    }));
    document.querySelector('#save-plan')?.addEventListener('click', (event) => {
      try { localStorage.setItem('yeast-plan', JSON.stringify({ city: citySlug, days: String(planDays), interests: selectedInterests })); event.currentTarget.textContent = 'Saved ✓'; } catch { event.currentTarget.textContent = 'Use a bookmark instead'; }
    });
  </script>
</BaseLayout>

<style>
  .plan-head { padding: 55px 0 80px; text-align: center; }
  .crumbs { display: flex; justify-content: center; gap: 8px; margin-bottom: 64px; color: var(--muted); font-size: 11px; }
  h1 { margin: 0 auto 25px; max-width: 1000px; font-family: var(--display); font-size: clamp(62px,10vw,135px); font-weight: 400; line-height: .85; letter-spacing: -.065em; }
  h1 span { color: transparent; background: var(--gradient); background-clip: text; }
  .lede { margin-inline: auto; }
  .chosen { width: max-content; max-width: 100%; margin: 24px auto 0; padding: 9px 14px; border-radius: 999px; background: var(--lime); font-size: 11px; font-weight: 800; }
  .plan-actions { display: flex; justify-content: center; gap: 10px; margin-top: 30px; }
  .overview { display: grid; gap: 26px; }
  .day-block { display: grid; grid-template-columns: .75fr 1.25fr; gap: 24px; padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255,255,255,.72); box-shadow: var(--shadow); }
  .day-side { padding: 10px; } .day-side > span { color: var(--coral); font-family: var(--display); font-size: 28px; } .day-side h2 { margin: 38px 0 14px; font-family: var(--display); font-size: 44px; font-weight: 400; line-height: .96; } .day-side p { color: var(--muted); font-size: 12px; text-transform: capitalize; }
  .stop-list { display: grid; align-content: start; }
  .stop-list > div { display: grid; grid-template-columns: 40px 1fr auto; gap: 12px; align-items: center; padding: 17px 0; border-bottom: 1px dashed var(--line); }
  .stop-list > div > span { color: var(--violet); font-size: 10px; font-weight: 900; } .stop-list p { display: grid; margin: 0; } .stop-list strong { font-family: var(--display); font-size: 21px; font-weight: 400; } .stop-list small { color: var(--muted); font-size: 10px; }
  .stop-list button { border: 0; color: var(--muted); background: none; font-size: 10px; font-weight: 750; text-decoration: underline; cursor: pointer; }
  .backup { grid-column: 1 / -1; display: grid; grid-template-columns: 80px 1fr; gap: 12px; padding: 16px 18px; border-radius: 14px; background: var(--sky); font-size: 12px; } .backup p { margin: 0; }
  .beta { margin-top: 28px; padding: 24px; border: 1px dashed var(--coral); border-radius: 18px; background: #fff2ec; } .beta p { margin: 6px 0 0; color: var(--muted); font-size: 12px; }
  @media (max-width: 720px) { .day-block { grid-template-columns: 1fr; } .day-side h2 { margin-top: 18px; } }
  @media (max-width: 480px) { .plan-actions { flex-direction: column; } .stop-list > div { grid-template-columns: 28px 1fr; } .stop-list button { grid-column: 2; justify-self: start; padding: 0; } }
</style>
