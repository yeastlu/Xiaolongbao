---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { cities, getCityRoutes } from "../../../data/content";
import { interestLabels } from "../../../data/site";

export function getStaticPaths() { return cities.map((city) => ({ params: { city: city.slug }, props: { city } })); }
const { city } = Astro.props;
const routes = getCityRoutes(city.slug);
---
<BaseLayout title={`${city.name} itineraries — Yeast Travel`} description={`${city.name} in 1–3 days: researched routes with bilingual addresses, timings, Amap links and weather backups.`} noindex={city.status !== "PUBLISHED"}>
  <section class:list={["city-hero", city.accent]}>
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>→</span><span>{city.name}</span></nav>
      <div class="city-title"><div><span class="eyebrow">{city.region} · Research preview</span><h1>{city.name}<small>{city.nameZh}</small></h1></div><p class="lede">{city.character}<br/><span>{city.intro}</span></p></div>
      <div class="city-facts"><div><b>Ideal stay</b><span>{city.idealDays}</span></div><div><b>Arriving</b><span>{city.arrival}</span></div><div><b>Season note</b><span>{city.season}</span></div></div>
    </div>
  </section>
  <section class="section shell">
    <div class="intro"><div><span class="eyebrow">Choose your time</span><h2>One day is a route.<br/>Three days become a city.</h2></div><div class="notice"><strong>Why “research preview”?</strong><p>Official sources were checked on 19 July 2026. These routes still need weekday, weekend, English-navigation and rain field tests before formal publication.</p></div></div>
    <div class="route-grid">
      {routes.map((route) => <article class:list={["route-card", "card", route.accent]}><span class="day">Day {route.day}</span><h3>{route.name}</h3><p>{route.summary}</p><div class="tags">{route.interests.map((item) => <span>{interestLabels[item]}</span>)}</div><dl><div><dt>Time</dt><dd>{route.duration}</dd></div><div><dt>Pace</dt><dd>{route.pace}</dd></div><div><dt>Stops</dt><dd>{route.stops.length}</dd></div></dl><a class="button" href={`/routes/${route.slug}`}>See the day →</a></article>)}
    </div>
    <div class="plans"><span class="eyebrow">Ready-made combinations</span><h2>How many days do you have?</h2><div>{[1,2,3].map((days) => <a class="button button-primary" href={`/cities/${city.slug}/${days}-day-plan`}>{days} {days === 1 ? "day" : "days"}</a>)}</div></div>
  </section>
</BaseLayout>

<style>
  .city-hero { padding: 55px 0 75px; border-bottom: 1px solid var(--line); }
  .city-hero.coral { background: linear-gradient(135deg,#ffe6dc,transparent); } .city-hero.lime { background: linear-gradient(135deg,#f3f7b7,transparent); } .city-hero.sky { background: linear-gradient(135deg,#dcecff,transparent); } .city-hero.violet { background: linear-gradient(135deg,#e2d8ff,transparent); }
  .crumbs { display: flex; gap: 9px; color: var(--muted); font-size: 11px; } .crumbs a { text-underline-offset: 3px; }
  .city-title { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 60px; margin-top: 80px; }
  h1 { margin: 0; font-family: var(--display); font-size: clamp(76px,13vw,170px); font-weight: 400; line-height: .73; letter-spacing: -.07em; }
  h1 small { display: block; margin: 26px 0 0 8px; color: var(--coral-dark); font-family: var(--body); font-size: 15px; font-weight: 900; letter-spacing: .18em; }
  .lede span { color: var(--muted); font-size: 16px; }
  .city-facts { display: grid; grid-template-columns: .6fr 1.2fr 1.2fr; gap: 20px; margin-top: 75px; padding-top: 22px; border-top: 1px solid var(--line); }
  .city-facts div { display: grid; gap: 6px; } .city-facts b, dt { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; } .city-facts span { color: var(--muted); font-size: 12px; }
  .intro { display: grid; grid-template-columns: 1fr .7fr; gap: 60px; align-items: end; margin-bottom: 44px; }
  h2 { margin: 0; font-family: var(--display); font-size: clamp(44px,6vw,76px); font-weight: 400; line-height: .95; letter-spacing: -.05em; }
  .notice { padding: 20px; border-radius: 18px; background: var(--lime); transform: rotate(1deg); } .notice strong { font-size: 12px; } .notice p { margin: 8px 0 0; font-size: 12px; }
  .route-grid { display: grid; gap: 20px; }
  .route-card { display: grid; grid-template-columns: 100px 1fr 1fr auto; align-items: center; gap: 24px; padding: 24px; box-shadow: none; }
  .day { color: var(--coral); font-family: var(--display); font-size: 26px; } .route-card h3 { margin: 0; font-family: var(--display); font-size: 34px; font-weight: 400; } .route-card > p { margin: 0; color: var(--muted); font-size: 12px; }
  .tags { display: none; } dl { display: flex; gap: 16px; margin: 0; } dl div { display: grid; } dd { margin: 2px 0 0; color: var(--muted); font-size: 11px; text-transform: capitalize; }
  .plans { margin-top: 90px; padding: 50px; border-radius: var(--radius); color: white; background: var(--ink); text-align: center; } .plans h2 { margin-bottom: 28px; } .plans > div { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  @media (max-width: 850px) { .city-title, .intro { grid-template-columns: 1fr; } .route-card { grid-template-columns: 80px 1fr auto; } .route-card > p, .route-card dl { display: none; } }
  @media (max-width: 560px) { .city-facts { grid-template-columns: 1fr; } .route-card { grid-template-columns: 1fr; } .route-card > p, .route-card dl { display: block; } .route-card dl { display: flex; } .plans { padding: 36px 20px; } }
</style>
