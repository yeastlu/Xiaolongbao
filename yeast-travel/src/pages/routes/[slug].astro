---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RouteTimeline from "../../components/RouteTimeline.astro";
import AmapOverview from "../../components/AmapOverview.astro";
import { routes, getCity } from "../../data/content";
import { interestLabels } from "../../data/site";
export function getStaticPaths() { return routes.map((route) => ({ params: { slug: route.slug }, props: { route } })); }
const { route } = Astro.props;
const city = getCity(route.city)!;
const jsonLd = { "@context": "https://schema.org", "@type": "TouristTrip", name: route.name, touristType: route.interests.map((item) => interestLabels[item]), itinerary: { "@type": "ItemList", itemListElement: route.stops.map((stop, index) => ({ "@type": "ListItem", position: index + 1, name: stop.name })) } };
---
<BaseLayout title={`${route.name}, ${city.name} — Yeast Travel`} description={route.summary} noindex={route.status !== "PUBLISHED"}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="route-head shell">
    <nav><a href="/">Home</a><span>→</span><a href={`/cities/${city.slug}`}>{city.name}</a><span>→</span><span>{route.name}</span></nav>
    <div class="head-grid"><div><span class="eyebrow">Day {route.day} · {route.verification === "FIELD_CHECKED" ? "Field checked" : "Research preview"}</span><h1>{route.name}</h1><p class="lede">{route.summary}</p><div class="tags">{route.interests.map((item) => <span class="tag">{interestLabels[item]}</span>)}</div></div><aside><dl><div><dt>Total time</dt><dd>{route.duration}</dd></div><div><dt>Pace</dt><dd>{route.pace}</dd></div><div><dt>Last checked</dt><dd>{route.lastChecked}</dd></div><div><dt>Coordinate system</dt><dd>GCJ-02 where available</dd></div></dl><a class="button button-primary map-overview" href={route.mapUrl} target="_blank" rel="noreferrer" data-route={route.slug}>Open starting point in Amap ↗</a></aside></div>
  </section>
  <div class="shell"><AmapOverview route={route} /></div>
  <section class="shell route-body">
    <div class="timeline-wrap"><RouteTimeline route={route} /></div>
    <aside class="route-aside"><div class="plan-b"><span>Rain plan</span><p>{route.rainyDay}</p></div><div class="plan-b"><span>Closure plan</span><p>{route.closureBackup}</p></div><div class="warning"><strong>Still in research preview</strong><p>This route has official-source checks but no complete field-walk record yet. Recheck each official source before travel.</p></div></aside>
  </section>
  <section class="shell next"><p>Building a longer trip?</p><a class="button button-dark" href={`/cities/${city.slug}/${Math.min(route.day + 1, 3)}-day-plan`}>See the combined plan →</a></section>
  <script is:inline define:vars={{ routeSlug: route.slug }}>document.querySelector('.map-overview')?.addEventListener('click', () => window.yeastTrack?.('map_opened', { route: routeSlug }));</script>
</BaseLayout>

<style>
  .route-head { padding: 55px 0 70px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px; color: var(--muted); font-size: 11px; }
  .head-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 70px; align-items: end; margin-top: 70px; }
  h1 { max-width: 900px; margin: 0 0 24px; font-family: var(--display); font-size: clamp(60px,9vw,120px); font-weight: 400; line-height: .84; letter-spacing: -.06em; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 24px; }
  aside dl { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 0 0 22px; } aside dl div { padding-top: 10px; border-top: 1px solid var(--line); } dt { font-size: 8px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; } dd { margin: 4px 0 0; color: var(--muted); font-size: 11px; text-transform: capitalize; }
  .map-overview { width: 100%; }
  .route-body { display: grid; grid-template-columns: 1fr 310px; gap: 34px; align-items: start; }
  .route-aside { position: sticky; top: 20px; display: grid; gap: 14px; }
  .plan-b, .warning { padding: 20px; border-radius: 18px; background: var(--sky); } .plan-b:nth-child(2) { background: var(--lime); } .warning { border: 1px dashed var(--coral); background: #fff1ed; }
  .plan-b span { font-size: 9px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; } .plan-b p, .warning p { margin: 8px 0 0; font-size: 12px; }
  .next { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 40px; padding: 32px; border: 1px solid var(--line); border-radius: var(--radius); } .next p { margin: 0; font-family: var(--display); font-size: 30px; }
  @media (max-width: 820px) { .head-grid, .route-body { grid-template-columns: 1fr; } .route-aside { position: static; } }
  @media (max-width: 480px) { h1 { font-size: 51px; overflow-wrap: anywhere; } .next { align-items: stretch; flex-direction: column; } }
</style>
